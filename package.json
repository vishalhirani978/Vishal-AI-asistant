{
  "name": "pixel-pm",
  "version": "1.0.0",
  "description": "Pixel PM — Vishal, your always-on AI project manager",
  "main": "main.js",
  "author": "Vishal Hirani <vishalhirani978@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@octokit/rest": "^19.0.13",
    "dotenv": "^17.4.2",
    "groq-sdk": "^1.2.0",
    "imap": "^0.8.19",
    "mailparser": "^3.9.9",
    "nodemailer": "^8.0.9",
    "puppeteer": "^25.1.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.vishalhirani.pixelpm",
    "productName": "Pixel PM",
    "copyright": "Copyright © 2025 Vishal Hirani",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "agents/**/*",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": ".env",
        "to": ".env",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "%USERPROFILE%/.cache/puppeteer",
        "to": "puppeteer-cache",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pixel PM",
      "deleteAppDataOnUninstall": false
    }
  }
}
